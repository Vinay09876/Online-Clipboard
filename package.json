{
  "name": "online-clipboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:collisions": "tsx --conditions=react-server --env-file=.env.local scripts/test-collisions.ts",
    "fixtures:cleanup": "tsx --conditions=react-server --env-file=.env.local scripts/cleanup-fixtures.ts",
    "test:files": "tsx --conditions=react-server --env-file=.env.local scripts/test-files.ts",
    "test:security": "tsx --conditions=react-server --env-file=.env.local scripts/test-security.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:egress": "tsx --conditions=react-server --env-file=.env.local scripts/test-egress.ts",
    "smoke:prod": "tsx scripts/smoke-prod.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "prebuild": "tsx scripts/check-placeholders.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
