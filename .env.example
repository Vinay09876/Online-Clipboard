# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → service_role key (SECRET, server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# How long a clip lives before it expires (minutes)
CLIP_EXPIRY_MINUTES=30

# Maximum upload size (megabytes)
MAX_FILE_SIZE_MB=25

# Protects POST /api/cron/cleanup. Header: "Authorization: Bearer <secret>".
# Min 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the cleanup endpoint rejects every request (fails closed).
CRON_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Security (Step 6)
# ---------------------------------------------------------------------------

# Secret salt for hashing client IPs before they are stored (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a salt is derived from SUPABASE_SERVICE_ROLE_KEY and a warning is logged.
IP_HASH_SALT=replace-with-a-long-random-string

# Global caps for the whole service (unexpired clips, including pending uploads).
MAX_LIVE_CLIPS=200
MAX_TOTAL_STORAGE_MB=800

# Rate limits: max requests per client IP per window. Defaults shown; usually leave unset.
# RATE_LIMIT_WINDOW_SECONDS=600     # window length (tests shorten this)
# RATE_LIMIT_LOOKUP_FAILURES=10     # failed (404) lookups: GET clip, download, complete
# RATE_LIMIT_CREATES=20             # POST /api/clips
# RATE_LIMIT_FILE_CREATES=5         # POST /api/clips with a file (in addition)
# RATE_LIMIT_FILE_OPS=30            # complete, download (each)
# RATE_LIMIT_HEALTH=30              # GET /api/health

# ---------------------------------------------------------------------------
# Production (Step 8)
# ---------------------------------------------------------------------------

# Monthly download budget in MB (UTC calendar month). Supabase free plan = 5 GB egress;
# keep headroom. When reached, file downloads return "paused until next month".
MAX_MONTHLY_DOWNLOAD_MB=4000

# Public email for abuse reports, shown on /terms. Leave empty to show a placeholder.
ABUSE_CONTACT_EMAIL=
