# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → service_role key (SECRET, server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# How long a clip lives before it expires (minutes)
CLIP_EXPIRY_MINUTES=30

# Maximum upload size (megabytes)
MAX_FILE_SIZE_MB=25

# Protects POST /api/cron/cleanup. Header: "Authorization: Bearer <secret>".
# Min 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the cleanup endpoint rejects every request (fails closed).
CRON_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Security (Step 6)
# ---------------------------------------------------------------------------

# Secret salt for hashing client IPs before they are stored (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a salt is derived from SUPABASE_SERVICE_ROLE_KEY and a warning is logged.
IP_HASH_SALT=replace-with-a-long-random-string

# Global caps for the whole service (unexpired clips, including pending uploads).
MAX_LIVE_CLIPS=200
MAX_TOTAL_STORAGE_MB=800

# Rate limits: max requests per client IP per window. Defaults shown; usually leave unset.
# RATE_LIMIT_WINDOW_SECONDS=600     # window length (tests shorten this)
# RATE_LIMIT_LOOKUP_FAILURES=10     # failed (404) lookups: GET clip, download, complete
# RATE_LIMIT_CREATES=20             # POST /api/clips
# RATE_LIMIT_FILE_CREATES=5         # POST /api/clips with a file (in addition)
# RATE_LIMIT_FILE_OPS=30            # complete, download (each)
# RATE_LIMIT_HEALTH=30              # GET /api/health

# ---------------------------------------------------------------------------
# Production (Step 8)
# ---------------------------------------------------------------------------

# Monthly download budget in MB (UTC calendar month). Supabase free plan = 5 GB egress;
# keep headroom. When reached, file downloads return "paused until next month".
MAX_MONTHLY_DOWNLOAD_MB=4000

# Public email for abuse reports. Leave empty to show a placeholder.
ABUSE_CONTACT_EMAIL=

# General contact address shown on /contact. Falls back to ABUSE_CONTACT_EMAIL when empty.
# On a real (indexable) domain, the build fails unless one of the two is set.
CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# SEO (Growth Step 1). See docs/seo.md.
# ---------------------------------------------------------------------------

# Public origin of the site, no path: https://example.com
# Used for canonical URLs, Open Graph URLs, robots.txt and the sitemap.
# Search engines may index the site ONLY when this is a real https domain:
# temporary hosts (*.vercel.app, *.netlify.app, localhost, IP addresses) are always noindex.
# Setting it to your current temporary URL is fine (correct share previews, still noindex).
SITE_URL=

# Kill switch: "false" = never index, whatever SITE_URL is. Leave empty otherwise.
ALLOW_INDEXING=

# ---------------------------------------------------------------------------
# Ads (Growth Step 4: code ready, switched OFF). See docs/ads-plan.md.
# Leave ALL of these empty until Step 9. Ads only ever show when ADS_ENABLED=true AND the site
# is indexable (real https domain) AND ADSENSE_CLIENT_ID is set. Never on temporary hosts.
# Malformed values fail the build and stop the server with a clear message.
# ---------------------------------------------------------------------------

# "true" = show ads (guide pages and /guides only). Empty or "false" = off.
ADS_ENABLED=

# AdSense publisher ID: ca-pub- followed by 16 digits. On an indexable domain this alone adds
# the google-adsense-account meta tag and /ads.txt (for ownership verification), even with ads off.
ADSENSE_CLIENT_ID=

# Numeric ad unit IDs (AdSense → Ads → By ad unit). A placement without an ID shows nothing.
ADSENSE_SLOT_GUIDE_AFTER_INTRO=
ADSENSE_SLOT_GUIDE_BEFORE_RELATED=
ADSENSE_SLOT_GUIDES_HUB=
